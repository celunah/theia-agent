[Unit]
Description=Theia Discord agent in Docker
Requires=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service
PartOf=gnome-keyring-daemon.service

[Service]
Type=exec
WorkingDirectory=%h/theia-agent
Environment=HOME=%h
Environment=THEIA_RUNTIME_DIR=%t
Environment=THEIA_UID=%U
Environment=THEIA_GID=%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.systemd.yaml up --build --force-recreate
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.systemd.yaml stop --timeout 30
Restart=on-failure
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=60

[Install]
WantedBy=default.target
