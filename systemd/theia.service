[Unit]
Description=Theia Discord agent in Docker
Requires=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service
PartOf=gnome-keyring-daemon.service

[Service]
Type=exec
WorkingDirectory=%h/theia-agent
Environment=HOME=%h
Environment=THEIA_RUNTIME_DIR=%t
Environment=THEIA_UID=%U
Environment=THEIA_GID=%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=THEIA_VAULT_PASSPHRASE_FILE=%h/theia-vault-password.txt
ExecStart=/usr/bin/python3 scripts/systemd_compose.py up --build --force-recreate
ExecStop=/usr/bin/python3 scripts/systemd_compose.py stop --timeout 30
Restart=on-failure
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=60

[Install]
WantedBy=default.target
