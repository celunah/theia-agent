# Discord bot token
TOKEN=
THEIA_DEFAULT_MODE=text
THEIA_APPROVAL_LEVEL=high
# Optional trusted Discord user IDs with global Theia administrator access
THEIA_ALWAYS_ADMIN_USERS=
THEIA_SELF_IMPROVEMENT=true
THEIA_SELF_IMPROVEMENT_TIMEOUT=90

# TTS and STT API configuration
STT_BASE_URL=
STT_TOKEN=
TTS_BASE_URL=
TTS_TOKEN=

# Enable auto-thread creation
THEIA_AUTO_THREAD=true

# Optional extra read-only roots for regular users
THEIA_SAFE_WORKSPACE_ROOTS=
THEIA_ATTACHMENT_CACHE_LIMIT_BYTES=536870912
