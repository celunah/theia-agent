# Discord bot token
TOKEN=
THEIA_DEFAULT_MODE=text
THEIA_APPROVAL_LEVEL=high
# Restart Codex after sustained RSS growth; set the limit to 0 to disable it
THEIA_CODEX_MEMORY_WATCHDOG=true
THEIA_CODEX_MAX_RSS_MB=6144
THEIA_CODEX_MEMORY_CHECK_INTERVAL=15
THEIA_CODEX_MEMORY_RESTART_GRACE=10
THEIA_CODEX_MEMORY_BREACH_SAMPLES=3
# Back off repeated memory-triggered restarts to avoid a restart loop
THEIA_CODEX_MEMORY_RESTART_BACKOFF=30
# Optional unattended Codex CLI updates. The staged CLI is kept in THEIA_HOME.
THEIA_CODEX_AUTO_UPDATE=false
THEIA_CODEX_UPDATE_INTERVAL=86400
THEIA_CODEX_UPDATE_TIMEOUT=120
# Optional trusted Discord user IDs with global Super Admin access
THEIA_SUPER_ADMIN_USERS=
THEIA_SELF_IMPROVEMENT=true
THEIA_SELF_IMPROVEMENT_TIMEOUT=90
THEIA_NIGHTLY_RECAP=true
# Optional IANA timezone; empty uses the host's local timezone
THEIA_NIGHTLY_RECAP_TIMEZONE=
THEIA_NIGHTLY_RECAP_TIMEOUT=120
THEIA_NIGHTLY_RECAP_CONTEXT_MAX_CHARACTERS=65536

# Optional model-generated Discord Rich Presence
THEIA_RICH_PRESENCE_ENABLED=true
THEIA_RICH_PRESENCE_ACTIVE_DEBOUNCE=3
THEIA_RICH_PRESENCE_IDLE_INTERVAL=900
THEIA_RICH_PRESENCE_RECENT_IDLE_INTERVAL=600
THEIA_RICH_PRESENCE_CONTEXT_MAX_AGE=1800
THEIA_RICH_PRESENCE_TIMEOUT=8

# Optional custom TTS and STT API configuration. Leave both URLs empty to use
# Codex Realtime voice through the bundled Codex app-server.
STT_PROTOCOL=openai-compatible
STT_BASE_URL=
STT_TOKEN=
STT_MODEL=whisper-1
TTS_PROTOCOL=openai-compatible
TTS_BASE_URL=
TTS_TOKEN=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
THEIA_AUDIO_PROVIDER=auto
THEIA_QWEN_AUDIO_URL=
THEIA_QWEN_AUDIO_TOKEN=
THEIA_QWEN_AUDIO_SEMANTIC_AUDIO=false
# Optional uploaded-media perception through Alibaba Model Studio. This is
# separate from the realtime voice transport and is disabled by default.
THEIA_QWEN_PERCEPTION_ENABLED=false
THEIA_QWEN_PERCEPTION_BASE_URL=
THEIA_QWEN_PERCEPTION_API_KEY=
THEIA_QWEN_PERCEPTION_MODEL=qwen3.8-omni-flash
THEIA_QWEN_PERCEPTION_MAX_FILE_BYTES=33554432
THEIA_QWEN_PERCEPTION_MAX_AUDIO_DURATION=0
THEIA_QWEN_PERCEPTION_MAX_VIDEO_DURATION=0
THEIA_QWEN_PERCEPTION_TIMEOUT=120
THEIA_QWEN_PERCEPTION_RETRIES=1
# Optional prices used only for local estimates in /usage; leave empty when unknown.
THEIA_QWEN_PERCEPTION_INPUT_USD_PER_MILLION=
THEIA_QWEN_PERCEPTION_OUTPUT_USD_PER_MILLION=
THEIA_REALTIME_MODEL=
THEIA_REALTIME_VOICE=

# Enable auto-thread creation
THEIA_AUTO_THREAD=true

# Optional extra read-only roots for regular users
THEIA_SAFE_WORKSPACE_ROOTS=
THEIA_ATTACHMENT_CACHE_LIMIT_BYTES=536870912
